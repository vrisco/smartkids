        ["Agudas", "última", "terminan en vocal, -n o -s", "camión, sofá, reloj"],
        ["Llanas", "penúltima", "NO terminan en vocal, -n o -s", "árbol, lápiz, casa"],
        ["Esdrújulas", "antepenúltima", "siempre", "pájaro, música"]
      ],
      "headerColumn": true
    },
    {
      "type": "callout",
